# CERBERO DEVELOPMENT ONLY
# These credentials are intentionally local, non-production defaults.
# Never reuse them in a real deployment.
CERBERO_DEV_MODE=1
CERBERO_SECURITY_PROFILE=DEVELOPMENT
CERBERO_INGEST_INSECURE_DEVELOPMENT=1

# DEVELOPMENT-ONLY JSON/HTTP ingest runtime.
# These values are explicit deployment knobs, not normative production limits.
CERBERO_INGEST_LISTEN_ADDRESS=127.0.0.1:19080
CERBERO_INGEST_HTTP_PATH=/ingest/v1/events
CERBERO_INGEST_MAX_PAYLOAD_SIZE=1048576
CERBERO_INGEST_MAX_CONNECTION_RATE=100
CERBERO_INGEST_MAX_EVENTS_PER_SECOND=1000
CERBERO_INGEST_READ_TIMEOUT=5s
CERBERO_INGEST_IDLE_TIMEOUT=30s
CERBERO_INGEST_CONCURRENT_CONNECTIONS=100
CERBERO_INGEST_SHUTDOWN_TIMEOUT=5s
CERBERO_INGEST_COMPONENT_VERSION=0.1.0-dev
CERBERO_INGEST_PIPELINE_VERSION=ingest-v1-dev
CERBERO_INGEST_INSTANCE_ID=ingest-dev-1
CERBERO_INGEST_DEV_TENANT_ID=tenant-dev
CERBERO_INGEST_DEV_SOURCE_ID=json-http-dev
CERBERO_INGEST_DEV_SENSOR_ID=json-http-dev-sensor
CERBERO_INGEST_DEV_REMOTE_IDENTITY=development-static-source
CERBERO_NATS_URL=nats://127.0.0.1:4222

POSTGRES_DB=cerbero
POSTGRES_USER=cerbero_dev_admin
POSTGRES_PASSWORD=DEV_ONLY_POSTGRES_CHANGE_ME
POSTGRES_PORT=5432

CLICKHOUSE_DB=cerbero
CLICKHOUSE_USER=cerbero_dev_admin
CLICKHOUSE_PASSWORD=DEV_ONLY_CLICKHOUSE_CHANGE_ME
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_ADMIN_USER=cerbero_dev_admin
NATS_ADMIN_PASSWORD=DEV_ONLY_NATS_ADMIN_CHANGE_ME
NATS_INGEST_USER=cerbero_ingest
NATS_INGEST_PASSWORD=DEV_ONLY_NATS_INGEST_CHANGE_ME
NATS_RAW_PRESERVER_USER=cerbero_raw_preserver
NATS_RAW_PRESERVER_PASSWORD=DEV_ONLY_NATS_RAW_PRESERVER_CHANGE_ME
NATS_NORMALIZER_USER=cerbero_normalizer
NATS_NORMALIZER_PASSWORD=DEV_ONLY_NATS_NORMALIZER_CHANGE_ME
NATS_DETECTION_USER=cerbero_detection
NATS_DETECTION_PASSWORD=DEV_ONLY_NATS_DETECTION_CHANGE_ME

CERBERO_RAW_STORE_PATH=./var/raw
