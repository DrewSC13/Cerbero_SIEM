# CERBERO DEVELOPMENT ONLY
# These credentials are intentionally local, non-production defaults.
# Never reuse them in a real deployment.
CERBERO_DEV_MODE=1
CERBERO_SECURITY_PROFILE=DEVELOPMENT
CERBERO_INGEST_INSECURE_DEVELOPMENT=1

# DEVELOPMENT-ONLY JSON/HTTP ingest runtime.
# These values are explicit deployment knobs, not normative production limits.
CERBERO_INGEST_LISTEN_ADDRESS=127.0.0.1:19080
CERBERO_INGEST_HTTP_PATH=/ingest/v1/events
CERBERO_INGEST_MAX_PAYLOAD_SIZE=1048576
CERBERO_INGEST_MAX_CONNECTION_RATE=100
CERBERO_INGEST_MAX_EVENTS_PER_SECOND=1000
CERBERO_INGEST_READ_TIMEOUT=5s
CERBERO_INGEST_IDLE_TIMEOUT=30s
CERBERO_INGEST_CONCURRENT_CONNECTIONS=100
CERBERO_INGEST_SHUTDOWN_TIMEOUT=5s
CERBERO_INGEST_COMPONENT_VERSION=0.1.0-dev
CERBERO_INGEST_PIPELINE_VERSION=ingest-v1-dev
CERBERO_INGEST_INSTANCE_ID=ingest-dev-1
CERBERO_INGEST_DEV_TENANT_ID=tenant-dev
CERBERO_INGEST_DEV_SOURCE_ID=json-http-dev
CERBERO_INGEST_DEV_SENSOR_ID=json-http-dev-sensor
CERBERO_INGEST_DEV_REMOTE_IDENTITY=development-static-source
CERBERO_NATS_URL=nats://127.0.0.1:4222

# DEVELOPMENT-ONLY normalizer runtime.
# Retry values are deployment knobs while the v1 architectural values remain open.
CERBERO_NORMALIZER_COMPONENT_VERSION=0.1.0-dev
CERBERO_NORMALIZER_INSTANCE_ID=normalizer-dev-1
CERBERO_NORMALIZER_PIPELINE_VERSION=normalizer-v1-dev
CERBERO_NORMALIZER_EXECUTION_MODE=LIVE
# REPLAY only: HISTORICAL preserves Step 17 raw.persisted replay; SELECTIVE consumes only raw.replay.
CERBERO_NORMALIZER_REPLAY_INPUT=HISTORICAL
# Governed SSH parser derivation. v1 remains the LIVE baseline; v2 is used for explicit renormalization tests.
CERBERO_NORMALIZER_LINUX_SSHD_PARSER_VERSION=1
# Optional DEVELOPMENT source-time policy map. Format: source_id=+HH:MM,source_id=-HH:MM
# Empty means ambiguous source timestamps remain unresolved; UTC is never assumed.
CERBERO_NORMALIZER_SOURCE_TIME_OFFSETS=
CERBERO_NORMALIZER_RETRY_MIN_SECONDS=1
CERBERO_NORMALIZER_RETRY_MAX_SECONDS=5
CERBERO_NORMALIZER_RETRY_BUDGET=5

# DEVELOPMENT-ONLY normalization-DLQ replay worker runtime.
CERBERO_WORKER_COMPONENT_VERSION=0.1.0-dev
CERBERO_WORKER_INSTANCE_ID=worker-dev-1
CERBERO_WORKER_CONNECT_TIMEOUT=5s
CERBERO_WORKER_REPLAY_MAX_AUTOMATIC_ATTEMPTS=2
CERBERO_WORKER_REPLAY_NAK_DELAY=5s

# DEVELOPMENT-ONLY raw-preserver runtime.
# Retry values are deployment knobs while the v1 architectural values remain open.
CERBERO_RAW_PRESERVER_COMPONENT_VERSION=0.1.0-dev
CERBERO_RAW_PRESERVER_INSTANCE_ID=raw-preserver-dev-1
CERBERO_RAW_PRESERVER_CONNECT_TIMEOUT=5s
CERBERO_RAW_PRESERVER_RETRY_MIN_DELAY=1s
CERBERO_RAW_PRESERVER_RETRY_MAX_DELAY=5s

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=cerbero
POSTGRES_USER=cerbero_dev_admin
POSTGRES_PASSWORD=DEV_ONLY_POSTGRES_CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_RAW_PRESERVER_USER=cerbero_raw_preserver_dev
POSTGRES_RAW_PRESERVER_PASSWORD=DEV_ONLY_POSTGRES_RAW_PRESERVER_CHANGE_ME
POSTGRES_NORMALIZER_USER=cerbero_normalizer_dev
POSTGRES_NORMALIZER_PASSWORD=DEV_ONLY_POSTGRES_NORMALIZER_CHANGE_ME
POSTGRES_WORKER_USER=cerbero_worker_dev
POSTGRES_WORKER_PASSWORD=DEV_ONLY_POSTGRES_WORKER_CHANGE_ME

CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_DB=cerbero
CLICKHOUSE_USER=cerbero_dev_admin
CLICKHOUSE_PASSWORD=DEV_ONLY_CLICKHOUSE_CHANGE_ME
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_NORMALIZER_USER=cerbero_normalizer_dev
CLICKHOUSE_NORMALIZER_PASSWORD=DEV_ONLY_CLICKHOUSE_NORMALIZER_CHANGE_ME
CLICKHOUSE_DETECTION_USER=cerbero_detection_dev
CLICKHOUSE_DETECTION_PASSWORD=DEV_ONLY_CLICKHOUSE_DETECTION_CHANGE_ME
CLICKHOUSE_API_USER=cerbero_api_dev
CLICKHOUSE_API_PASSWORD=DEV_ONLY_CLICKHOUSE_API_CHANGE_ME

NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_ADMIN_USER=cerbero_dev_admin
NATS_ADMIN_PASSWORD=DEV_ONLY_NATS_ADMIN_CHANGE_ME
NATS_INGEST_USER=cerbero_ingest
NATS_INGEST_PASSWORD=DEV_ONLY_NATS_INGEST_CHANGE_ME
NATS_RAW_PRESERVER_USER=cerbero_raw_preserver
NATS_RAW_PRESERVER_PASSWORD=DEV_ONLY_NATS_RAW_PRESERVER_CHANGE_ME
NATS_NORMALIZER_USER=cerbero_normalizer
NATS_NORMALIZER_PASSWORD=DEV_ONLY_NATS_NORMALIZER_CHANGE_ME
NATS_WORKER_USER=cerbero_worker
NATS_WORKER_PASSWORD=DEV_ONLY_NATS_WORKER_CHANGE_ME
NATS_DETECTION_USER=cerbero_detection
NATS_DETECTION_PASSWORD=DEV_ONLY_NATS_DETECTION_CHANGE_ME

CERBERO_RAW_STORE_PATH=./var/raw

# DEVELOPMENT-ONLY Step 30 analytical persistence/API.
CERBERO_API_LISTEN_ADDRESS=127.0.0.1:19081
POSTGRES_DETECTION_USER=cerbero_detection_dev
POSTGRES_DETECTION_PASSWORD=DEV_ONLY_POSTGRES_DETECTION_CHANGE_ME
POSTGRES_API_USER=cerbero_api_dev
POSTGRES_API_PASSWORD=DEV_ONLY_POSTGRES_API_CHANGE_ME

# DEVELOPMENT-ONLY Step34 source/frontends and composed application build.
# Container wildcard binds are never implicit and host-published ports remain loopback-only.
CERBERO_INGEST_CONTAINER_DEVELOPMENT=0
CERBERO_INGEST_HOST_PORT=19080
CERBERO_API_HOST_PORT=19081
CERBERO_SYSLOG_HOST_PORT=19514
CERBERO_SYSLOG_LISTEN_ADDRESS=127.0.0.1:19514
CERBERO_SYSLOG_CONTAINER_DEVELOPMENT=0
CERBERO_SYSLOG_INSTANCE_ID=syslog-dev-1
CERBERO_SYSLOG_DEV_TENANT_ID=018f47a2-4b00-7a00-8000-00000000d034
CERBERO_SYSLOG_DEV_SOURCE_ID=syslog-dev
CERBERO_SYSLOG_DEV_SENSOR_ID=syslog-dev-sensor
CERBERO_SYSLOG_DEV_REMOTE_IDENTITY=development-static-syslog-source
CERBERO_JOURNALD_INSTANCE_ID=journald-dev-1
CERBERO_JOURNALD_DEV_TENANT_ID=018f47a2-4b00-7a00-8000-00000000d035
CERBERO_JOURNALD_DEV_SOURCE_ID=journald-dev
CERBERO_JOURNALD_DEV_SENSOR_ID=journald-dev-sensor
CERBERO_JOURNALD_DEV_REMOTE_IDENTITY=development-local-journal-source
CERBERO_JOURNALD_CURSOR_FILE=./var/journald.cursor
CERBERO_JOURNALD_EXPORT_FILE=
CERBERO_APP_IMAGE_TAG=step34-dev
CERBERO_GO_BUILD_IMAGE=golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195
CERBERO_RUST_BUILD_IMAGE=rust:1.98.1-bookworm@sha256:9a73a5088750b4c95158ab26629c854c3d6fc4b173cb7bc8079ad252d8ed7bfa
CERBERO_DEBIAN_RUNTIME_IMAGE=debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
