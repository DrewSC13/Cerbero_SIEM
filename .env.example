# CERBERO DEVELOPMENT ONLY
# These credentials are intentionally local, non-production defaults.
# Never reuse them in a real deployment.
CERBERO_DEV_MODE=1

POSTGRES_DB=cerbero
POSTGRES_USER=cerbero_dev_admin
POSTGRES_PASSWORD=DEV_ONLY_POSTGRES_CHANGE_ME
POSTGRES_PORT=5432

CLICKHOUSE_DB=cerbero
CLICKHOUSE_USER=cerbero_dev_admin
CLICKHOUSE_PASSWORD=DEV_ONLY_CLICKHOUSE_CHANGE_ME
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_ADMIN_USER=cerbero_dev_admin
NATS_ADMIN_PASSWORD=DEV_ONLY_NATS_ADMIN_CHANGE_ME
NATS_INGEST_USER=cerbero_ingest
NATS_INGEST_PASSWORD=DEV_ONLY_NATS_INGEST_CHANGE_ME
NATS_RAW_PRESERVER_USER=cerbero_raw_preserver
NATS_RAW_PRESERVER_PASSWORD=DEV_ONLY_NATS_RAW_PRESERVER_CHANGE_ME
NATS_NORMALIZER_USER=cerbero_normalizer
NATS_NORMALIZER_PASSWORD=DEV_ONLY_NATS_NORMALIZER_CHANGE_ME
NATS_DETECTION_USER=cerbero_detection
NATS_DETECTION_PASSWORD=DEV_ONLY_NATS_DETECTION_CHANGE_ME

CERBERO_RAW_STORE_PATH=./var/raw
